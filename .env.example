# ---- Dashboard ----
# Tek kullanıcılı giriş şifresi. Uzun ve rastgele seç.
DASHBOARD_PASSWORD=
# Oturum çerezini imzalamak için rastgele 32+ karakter (openssl rand -hex 32)
SESSION_SECRET=

# ---- Supabase (EDITH'e ait YENİ proje — uygulamanınkiyle aynı olmasın) ----
SUPABASE_URL=
# service_role key: yalnızca sunucu tarafında kullanılır, tarayıcıya asla gitmez.
SUPABASE_SERVICE_KEY=

# ---- AI ----
# deepseek | qwen
AI_PROVIDER=deepseek
AI_API_KEY=
# Sağlayıcının OpenAI-uyumlu uç noktası (OpenRouter/OpenCode kullanıyorsan onun adresi)
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-v4-flash

# ---- Reddit (script tipi app: reddit.com/prefs/apps) ----
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
# Reddit kuralı: gerçek ve tanımlayıcı olmalı.
REDDIT_USER_AGENT=web:edith-growth-assistant:v0.1.0 (by /u/KULLANICI_ADIN)
